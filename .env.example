# Локальная разработка: cp .env.example .env
# Настоящие переменные окружения важнее значений из этого файла.

DJANGO_DEBUG=1

# На сервере DJANGO_DEBUG не задавать, секретный ключ обязателен:
# DJANGO_SECRET_KEY=длинная-случайная-строка
# DJANGO_ALLOWED_HOSTS=shop.example.ru
# DJANGO_CSRF_TRUSTED_ORIGINS=https://shop.example.ru
# DJANGO_Q_SYNC=0

# PostgreSQL вместо SQLite:
# DATABASE_URL=postgres://user:password@127.0.0.1:5432/smart_shopping

# Если runserver работает не на 127.0.0.1:8000 (адрес демо-фидов):
# DEMO_FEEDS_BASE_URL=http://127.0.0.1:8000/static/demo_feeds

# Уровень логов импорта (по умолчанию INFO):
# DJANGO_LOG_LEVEL=WARNING
